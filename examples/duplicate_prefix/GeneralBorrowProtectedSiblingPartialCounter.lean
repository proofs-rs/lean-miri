import duplicate_prefix.GeneralBorrowProtectedSiblingPartialFunctionHistory
namespace DuplicatePrefix.GeneralBorrowProtectedSiblingPartialCounter
open Miri.ABI Miri.Memory Miri.TreeBorrows Miri.TreeBorrows.Tree
open GeneralBorrowProtectedSiblingPartial
set_option maxRecDepth 65536
set_option maxHeartbeats 6000000
set_option backward.isDefEq.respectTransparency false
set_option backward.dsimp.instances true

theorem step (tree : BorrowTree) (global : GlobalState) (frame : FrameState) (id : AllocId)
    (parent : BorTag) (offset len : UInt64) (mode : ChildrenVisitMode) (output : GeneralBorrowForestFnEntry.Output)
    (actual : GeneralBorrowForestFnEntry.operation tree global frame id parent offset len mode = .ok output) :
    output.global.nextPointerTag.value.toNat = global.nextPointerTag.value.toNat+1 := by
  have notMax : global.nextPointerTag.value ≠ 18446744073709551615 := by
    intro same
    simp [GeneralBorrowForestFnEntry.operation,GlobalState.newPointerTag,BorTag.succ,same,bind,Except.bind] at actual
  have fresh : global.nextPointerTag.value < 18446744073709551615 := by
    apply UInt64.lt_iff_toNat_lt.mpr
    change global.nextPointerTag.value.toNat < 18446744073709551615
    have bounded := global.nextPointerTag.value.toNat_lt_size
    change global.nextPointerTag.value.toNat < 18446744073709551616 at bounded
    have different : global.nextPointerTag.value.toNat ≠ 18446744073709551615 := by
      intro equal
      apply notMax
      exact UInt64.toNat_inj.mp equal
    omega
  unfold GeneralBorrowForestFnEntry.operation at actual
  rw [TypedRetagEmpty.allocate_tag global fresh] at actual
  simp only [Except.bind,bind,pure,Except.pure] at actual
  cases actual
  exact GeneralBorrowProtectedSiblingGenerationBounds.successor_nat _ fresh

theorem loop {bytes} (windows : List (Window bytes)) (before after : Snapshot)
    (actual : GeneralBorrowProtectedSiblingPartial.loop windows before = .ok after) :
    after.global.nextPointerTag.value.toNat = before.global.nextPointerTag.value.toNat+windows.length := by
  induction windows generalizing before with
  | nil => cases actual;simp
  | cons window rest ih =>
    unfold GeneralBorrowProtectedSiblingPartial.loop at actual
    cases current : GeneralBorrowForestFnEntry.operation before.tree before.global before.frame
        GeneralBorrowProtectedSiblingGenerationWindowSeed.allocation BorTag.one window.offset window.len .VisitChildrenOfAccessed with
    | error error => simp [current,bind,Except.bind] at actual
    | ok output =>
      simp only [current,bind,Except.bind] at actual
      have later := ih _ actual
      change after.global.nextPointerTag.value.toNat = output.global.nextPointerTag.value.toNat+rest.length at later
      have first := step _ _ _ _ _ _ _ _ output current
      simp only [List.length_cons]
      omega

theorem generated (bytes : UInt64) (windows : List (Window bytes)) (state : Snapshot)
    (actual : GeneralBorrowProtectedSiblingPartial.operation bytes windows = .ok state) :
    state.global.nextPointerTag.value.toNat = windows.length+2 := by
  unfold GeneralBorrowProtectedSiblingPartial.operation at actual
  rw [GeneralBorrowProtectedSiblingGenerationWindowSeed.root_allocation] at actual
  simp only [bind,Except.bind] at actual
  have counter := loop windows _ state actual
  change state.global.nextPointerTag.value.toNat = 2+windows.length at counter
  omega

theorem completed (bytes : UInt64) (windows : List (Window bytes)) (output : GeneralBorrowProtectedSiblingPartialFunctionHistory.Output)
    (actual : GeneralBorrowProtectedSiblingPartialFunctionHistory.operation bytes windows = .ok output) :
    output.ended.nextPointerTag.value.toNat = windows.length+2 := by
  unfold GeneralBorrowProtectedSiblingPartialFunctionHistory.operation at actual
  cases current : GeneralBorrowProtectedSiblingPartial.operation bytes windows with
  | error error => simp [current,bind,Except.bind] at actual
  | ok state =>
    simp only [current,bind,Except.bind,pure,Except.pure] at actual
    cases actual
    exact generated bytes windows state current
end DuplicatePrefix.GeneralBorrowProtectedSiblingPartialCounter
