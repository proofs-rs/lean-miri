/-! Kernel compilation and transitive axiom audit. This checks the imported
program and component lemmas; it is not a whole-function safety certificate. -/

namespace DuplicatePrefix.Program

theorem pinnedTarget : imported.document.producer.targetTriple =
    "x86_64-unknown-linux-gnu" := by rfl

theorem pinnedMiri : imported.document.producer.miriCommit =
    "7fa591d7d4dd9af8154becbc8332f8096f8323b1" := by rfl

/-- Structural export readiness; this does not assert semantic coverage. -/
theorem structurallyReady : imported.executionInput.isSome = true := by rfl

end DuplicatePrefix.Program

open Lean Elab Command in
run_cmd do
  let declarations := #[
    ``DuplicatePrefix.Program.pinnedTarget,
    ``DuplicatePrefix.Program.pinnedMiri,
    ``DuplicatePrefix.Program.structurallyReady,
    ``DuplicatePrefix.copy_fits,
    ``DuplicatePrefix.usize_guard,
    ``DuplicatePrefix.size_add_ok,
    ``DuplicatePrefix.size_mul_one,
    ``DuplicatePrefix.signed_size_ok,
    ``DuplicatePrefix.source_end,
    ``DuplicatePrefix.adjacent_overlap_check,
    ``DuplicatePrefix.copy_intervals,
    ``DuplicatePrefix.checkedBounds_ok,
    ``DuplicatePrefix.copy_bounds_ok,
    ``DuplicatePrefix.guarded_copy_checks,
    ``DuplicatePrefix.PointerAccess.dereference_ok,
    ``DuplicatePrefix.Borrows.mutable_fnentry_policy,
    ``DuplicatePrefix.Borrows.mutable_fnentry_read_write_and_return,
    ``DuplicatePrefix.CallSafety.noErrors_implies_noUB,
    ``DuplicatePrefix.CallSafety.invariant_on_reachable,
    ``DuplicatePrefix.CallSafety.no_scoped_step_after_return,
    ``DuplicatePrefix.CallSafety.noErrors_of_invariant,
    ``DuplicatePrefix.Alignment.u8_checkPtrAlign_all_pointers]
  for declaration in declarations do
    for dependency in (← collectAxioms declaration) do
      unless #[``propext, ``Quot.sound, ``Classical.choice].contains dependency do
        throwError "{declaration} depends on unapproved axiom {dependency}"

-- Audit every imported theorem and all owned declarations, including private/generated definitions.
open Lean Elab Command in
run_cmd do
  let mut theorems : Nat := 0
  let mut owned : Nat := 0
  for (name, info) in (← getEnv).constants.toList do
    let theoremDecl := match info with | .thmInfo _ => true | _ => false
    let own := (name.toString.splitOn "DuplicatePrefix.").length != 1
    if theoremDecl then theorems := theorems + 1
    if own then owned := owned + 1
    if theoremDecl || own then
      for dependency in (← collectAxioms name) do
        unless #[``propext, ``Quot.sound, ``Classical.choice].contains dependency do
          throwError "{name} depends on unapproved axiom {dependency}"
  logInfo m!"PASS: audited {theorems} imported theorems and {owned} owned declarations"
