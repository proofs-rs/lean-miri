open Lean Elab Command in
run_cmd do
  for declaration in [``positive, ``live_zero, ``nonlive_zero, ``integer_zero] do
    for dependency in (← collectAxioms declaration) do
      unless #[``propext, ``Quot.sound, ``Classical.choice].contains dependency do
        throwError "unapproved complete len call {dependency}"
end
end DuplicatePrefix.LenCall
