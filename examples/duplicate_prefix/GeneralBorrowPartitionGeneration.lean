import duplicate_prefix.GeneralBorrowReusableGeneration
import duplicate_prefix.GeneralBorrowPartitionHistory

namespace DuplicatePrefix.GeneralBorrowPartitionGeneration
open Miri.ABI Miri.Memory Miri.DataStructures Miri.TreeBorrows Miri.TreeBorrows.Tree
open DuplicatePrefix.GeneralBorrowReusableHistory DuplicatePrefix.GeneralBorrowReusableGeneration
set_option maxRecDepth 65536
set_option maxHeartbeats 2000000

set_option autoImplicit false in
/-- Actual mixed history followed by actual partial-range accesses. All borrow
invariants and completed operations are conclusions of generation. -/
structure Generated (bytes : UInt64) (rootTag tag : BorTag) (prior : List Action)
    (reserve : Fin 5 → BorTag) (accesses : List (GeneralBorrowPartitionHistory.Action bytes)) where
  state : GeneralBorrowPartitionState.State
    (GeneralBorrowPartitionHistory.execute (execute (BorrowTree.new rootTag (Size.ofBytes bytes)) rootTag bytes prior) rootTag accesses)
    GeneralBorrowFullSharedSeed.root bytes
  prefixCompleted : AllCompleted (BorrowTree.new rootTag (Size.ofBytes bytes)) rootTag bytes prior
  suffixCompleted : GeneralBorrowPartitionHistory.AllCompleted (execute (BorrowTree.new rootTag (Size.ofBytes bytes)) rootTag bytes prior) rootTag accesses
  tagged : state.node.tag = rootTag
  fresh : GeneralBorrowTagMap.Fresh
    (GeneralBorrowPartitionHistory.execute (execute (BorrowTree.new rootTag (Size.ofBytes bytes)) rootTag bytes prior) rootTag accesses).tagMapping tag
  reserved : ∀ i, GeneralBorrowTagMap.Fresh
    (GeneralBorrowPartitionHistory.execute (execute (BorrowTree.new rootTag (Size.ofBytes bytes)) rootTag bytes prior) rootTag accesses).tagMapping (reserve i)

/-- Extend the allocation-derived mixed shared/GC protocol by arbitrary finite
in-bounds partial-range Reads and Writes, without any poststate/success premise. -/
noncomputable def extend (bytes : UInt64) (rootTag tag : BorTag) (prior : List Action)
    (reserve : Fin 5 → BorTag) (initial : GeneralBorrowReusableGeneration.Generated bytes rootTag tag prior reserve)
    (accesses : List (GeneralBorrowPartitionHistory.Action bytes)) : Generated bytes rootTag tag prior reserve accesses := by
  let start := GeneralBorrowPartitionState.of_reusable _ GeneralBorrowFullSharedSeed.root bytes initial.state
  have tagged : start.node.tag = rootTag := initial.tagged
  have history := GeneralBorrowPartitionHistory.run _ GeneralBorrowFullSharedSeed.root bytes rootTag start tagged accesses
  let post := Classical.choice history.2.1
  exact ⟨post.val,initial.completed,history.1,post.property,
    history.2.2.2 ▸ initial.fresh,fun i => history.2.2.2 ▸ initial.reserved i⟩

end DuplicatePrefix.GeneralBorrowPartitionGeneration
