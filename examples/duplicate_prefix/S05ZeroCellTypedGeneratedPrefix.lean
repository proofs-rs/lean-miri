import Miri.TreeBorrows.TreeState
import Init.Internal.Order.While
import Miri.Memory.Pointer
import Lean
attribute [local cbv_eval] Lean.Loop.forIn_eq_of_monadTail

/-! Component completion regressions for the included wildcard postorder repair. -/

/-! One correlated, finite source-generated Tree Borrows prefix using the actual
mutable initial accessed flag.  This module
does not identify the generated tree with the older six-node literal.  Typed
operation and ordinary-input coverage are separate obligations. -/
namespace DuplicatePrefix.S05ZeroCellTypedGeneratedPrefix
open Miri Miri.ABI Miri.Memory Miri.DataStructures
open Miri.TreeBorrows Miri.TreeBorrows.Tree
attribute [local cbv_eval] Lean.Loop.forIn_eq_of_monadTail
set_option cbv.maxSteps 1000000
set_option maxRecDepth 65536
set_option autoImplicit false
set_option maxHeartbeats 8000000

def tag (n : UInt64) (nonzero : n ≠ 0 := by decide) : BorTag := ⟨n,nonzero⟩
def zeroCell : LocationState := ⟨.Cell,false,.Write⟩
def mutable : LocationState := ⟨.ReservedFrz false,true,.Read⟩
def seed : BorrowTree := BorrowTree.new (tag 1) (Size.ofBytes 2)
def exposed := seed.exposeTag {} (tag 1)
def a := exposed.tree.newChild Size.ZERO .wildcard (tag 2)
  (DedupRangeMap.new Size.ZERO zeroCell) .Cell false
def dRead := a.tree.performBorrowAccessRange (.concrete (tag 2)) Size.ZERO
  (Size.ofBytes 2) .Read {} .VisitChildrenOfAccessed
def d := dRead.tree.newChild Size.ZERO (.concrete (tag 2)) (tag 3)
  (DedupRangeMap.new (Size.ofBytes 2) mutable) (.ReservedFrz false) false
def firstWrite := d.tree.performBorrowAccessRange (.concrete (tag 1)) Size.ZERO
  (Size.ofBytes 2) .Write {} .VisitChildrenOfAccessed
def b := firstWrite.tree.newChild Size.ZERO .wildcard (tag 4)
  (DedupRangeMap.new Size.ZERO zeroCell) .Cell false
def v := b.tree.newChild Size.ZERO (.concrete (tag 3)) (tag 5)
  (DedupRangeMap.new Size.ZERO mutable) (.ReservedFrz false) false
def exposedV := v.tree.exposeTag {} (tag 5)
def secondWrite := exposedV.tree.performBorrowAccessRange (.concrete (tag 1)) Size.ZERO
  (Size.ofBytes 2) .Write {} .VisitChildrenOfAccessed
def wRead := secondWrite.tree.performBorrowAccessRange (.concrete (tag 4)) Size.ZERO
  (Size.ofBytes 2) .Read {} .VisitChildrenOfAccessed
def w := wRead.tree.newChild Size.ZERO (.concrete (tag 4)) (tag 6)
  (DedupRangeMap.new (Size.ofBytes 2) mutable) (.ReservedFrz false) false

theorem operations_complete :
    exposed.outcome = .ok () ∧ a.outcome = .ok () ∧
    dRead.status = .Completed ∧ d.outcome = .ok () ∧
    firstWrite.status = .Completed ∧ b.outcome = .ok () ∧
    v.outcome = .ok () ∧ exposedV.outcome = .ok () ∧
    secondWrite.status = .Completed ∧ wRead.status = .Completed ∧
    w.outcome = .ok () := by
  cbv

def ix (n : Nat) : UniIndex := ⟨UInt32.ofNat n⟩

/-- Stored raw D retains its allocation/tag/address even when the pointee loan
has been disabled.  This is identity of the copied pointer, not dereference
permission for a positive length. -/
def savedRawD (id : AllocId) (address : UInt64) : Pointer Provenance :=
  Pointer.new (.concrete id (tag 3)) (Size.ofBytes address)

theorem saved_raw_identity (id : AllocId) (address : UInt64) :
    (savedRawD id address).provenance = .concrete id (tag 3) ∧
    (savedRawD id address).offset = Size.ofBytes address := ⟨rfl,rfl⟩

/-- A and B have the defaults generated by their respective positive child
retags.  No equality to the obsolete six-node fixture is assumed. -/
theorem generated_defaults :
    (w.tree.nodeAt (ix 1)).map TreeNode.defaultInitialSifa = some .Read ∧
    (w.tree.nodeAt (ix 3)).map TreeNode.defaultInitialSifa = some .Read := by cbv

/-- The intervening original Write really invalidates the positive D loan. -/
theorem d_disabled :
    (firstWrite.tree.locations.entries[0]'(by cbv)).data.perms.get (ix 2) =
      some ⟨.Disabled,true,.Write⟩ := by cbv

/-- The final nonzero W loan and the original Cell materializations are
checked on the generated tree itself. -/
theorem final_permissions :
    (w.tree.locations.entries[0]'(by cbv)).data.perms.get (ix 1) = some ⟨.Cell,true,.Write⟩ ∧
    (w.tree.locations.entries[0]'(by cbv)).data.perms.get (ix 3) = some ⟨.Cell,true,.None⟩ ∧
    (w.tree.locations.entries[0]'(by cbv)).data.perms.get (ix 5) = some mutable := by cbv

/-- Every newChild in this finite prefix is explicitly unprotected. -/
theorem no_protectors :
    ({} : ProtectedTags).contains (tag 2) = false ∧
    ({} : ProtectedTags).contains (tag 3) = false ∧
    ({} : ProtectedTags).contains (tag 4) = false ∧
    ({} : ProtectedTags).contains (tag 5) = false ∧
    ({} : ProtectedTags).contains (tag 6) = false := by cbv

/-- A joint concrete interpretation uses the one stable original tag at
both uses of the single wildcard pointer. All other tags, sizes, offsets,
permissions and protection flags agree with the raw source prefix. -/
def preciseA := exposed.tree.newChild Size.ZERO (.concrete (tag 1)) (tag 2)
  (DedupRangeMap.new Size.ZERO zeroCell) .Cell false
def preciseDRead := preciseA.tree.performBorrowAccessRange (.concrete (tag 2)) Size.ZERO
  (Size.ofBytes 2) .Read {} .VisitChildrenOfAccessed
def preciseD := preciseDRead.tree.newChild Size.ZERO (.concrete (tag 2)) (tag 3)
  (DedupRangeMap.new (Size.ofBytes 2) mutable) (.ReservedFrz false) false
def preciseFirstWrite := preciseD.tree.performBorrowAccessRange (.concrete (tag 1)) Size.ZERO
  (Size.ofBytes 2) .Write {} .VisitChildrenOfAccessed
def preciseB := preciseFirstWrite.tree.newChild Size.ZERO (.concrete (tag 1)) (tag 4)
  (DedupRangeMap.new Size.ZERO zeroCell) .Cell false
def preciseV := preciseB.tree.newChild Size.ZERO (.concrete (tag 3)) (tag 5)
  (DedupRangeMap.new Size.ZERO mutable) (.ReservedFrz false) false
def preciseExposedV := preciseV.tree.exposeTag {} (tag 5)
def preciseSecondWrite := preciseExposedV.tree.performBorrowAccessRange (.concrete (tag 1)) Size.ZERO
  (Size.ofBytes 2) .Write {} .VisitChildrenOfAccessed
def preciseWRead := preciseSecondWrite.tree.performBorrowAccessRange (.concrete (tag 4)) Size.ZERO
  (Size.ofBytes 2) .Read {} .VisitChildrenOfAccessed
def preciseW := preciseWRead.tree.newChild Size.ZERO (.concrete (tag 4)) (tag 6)
  (DedupRangeMap.new (Size.ofBytes 2) mutable) (.ReservedFrz false) false

theorem precise_operations_complete :
    preciseA.outcome = .ok () ∧ preciseDRead.status = .Completed ∧
    preciseD.outcome = .ok () ∧ preciseFirstWrite.status = .Completed ∧
    preciseB.outcome = .ok () ∧ preciseV.outcome = .ok () ∧
    preciseExposedV.outcome = .ok () ∧ preciseSecondWrite.status = .Completed ∧
    preciseWRead.status = .Completed ∧ preciseW.outcome = .ok () := by cbv

/-- Both creations occur while the SAME original is exposed and has Unique
permission for the full allocation; origin availability is independently
checked rather than inferred from wildcard operation success. -/
theorem stable_origin_available :
    (exposed.tree.nodeAt (ix 0)).map TreeNode.isExposed = some true ∧
    (preciseFirstWrite.tree.nodeAt (ix 0)).map TreeNode.isExposed = some true ∧
    (exposed.tree.locations.entries[0]'(by cbv)).data.perms.get (ix 0) =
      some ⟨.Unique,true,.None⟩ ∧
    (preciseFirstWrite.tree.locations.entries[0]'(by cbv)).data.perms.get (ix 0) =
      some ⟨.Unique,true,.None⟩ := by cbv

/-- The precise final W has positive-range read/write authority. This finite
fact alone is not adequacy of any proposed ordinary-call predicate. -/
theorem precise_w_write :
    (preciseW.tree.performBorrowAccessRange (.concrete (tag 6)) Size.ZERO
      (Size.ofBytes 2) .Write {} .VisitChildrenOfAccessed).status = .Completed := by cbv

/-- Completion regression for the actual generated component under the
revised visitor; the historical diagnostic belongs to the old pinned source. -/
theorem generated_component_completed :
    (w.tree.performWildcardAccessAt (w.tree.locations.entries[0]'(by cbv)).data
      (ix 1) (some (tag 4)) .Write {} true).status = .Completed := by cbv

theorem generated_child_effects_retained :
    ((w.tree.performWildcardAccessAt (w.tree.locations.entries[0]'(by cbv)).data
      (ix 1) (some (tag 4)) .Write {} true).location.perms.get (ix 4)).map (·.permission) =
      some .Disabled := by cbv

theorem generated_child_cache_retained :
    (w.tree.performWildcardAccessAt (w.tree.locations.entries[0]'(by cbv)).data
      (ix 1) (some (tag 4)) .Write {} true).location.exposedCache.nodes.get (ix 1) =
      some ⟨0,0⟩ := by cbv

end DuplicatePrefix.S05ZeroCellTypedGeneratedPrefix

open Lean Elab Command in
run_cmd do
  for (name, _) in (← getEnv).constants.toList do
    if name.toString.startsWith "DuplicatePrefix.S05ZeroCellTypedGeneratedPrefix." then
      for dependency in (← collectAxioms name) do
        unless #[``propext, ``Quot.sound, ``Classical.choice].contains dependency do
          throwError "unapproved correlated-prefix dependency {dependency}"
