#!/usr/bin/env python3
"""Export a Rust root and write its typed Lean safety verification condition."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile
import time

REPO = Path(__file__).resolve().parent.parent


def run(args, *, env=None, capture=False):
    return subprocess.run(
        args, cwd=REPO, env=env, check=True, text=True,
        stdout=subprocess.PIPE if capture else None,
    )


def rust_root(source, explicit):
    if explicit:
        return explicit
    code = re.sub(r"/\*.*?\*/|//[^\n]*", "", source.read_text(), flags=re.S)
    top = re.findall(
        r"^(pub(?:\([^\n)]*\))?\s+)?(?:(?:unsafe|async|const|extern(?:\s+\"[^\"]*\")?)\s+)*"
        r"fn\s+([a-zA-Z_]\w*)\s*[<(]", code, re.M,
    )
    names = [name for _, name in top]
    if "main" in names:
        return "main"
    if source.stem in names:
        return source.stem
    public = [name for visibility, name in top if visibility]
    if len(public) == 1:
        return public[0]
    if len(names) == 1:
        return names[0]
    raise ValueError("could not infer a unique Rust function; pass --root with its Rust def-path")


def lean_string(value):
    return json.dumps(str(value), ensure_ascii=False)


def exporter_environment(env):
    sysroot = Path(env.get("MIRI_SYSROOT", REPO / "scratch" / "lake" / "miri-sysroot"))
    if not (REPO / sysroot).is_dir():
        raise ValueError("pinned Miri sysroot is missing; run tools/setup-miri-reference.sh")
    target = Path(env.get("CARGO_TARGET_DIR", REPO / "exporter" / "target"))
    if not (REPO / target / "release" / "lean-miri-mir-exporter").is_file():
        run(["bash", "tools/build-exporter.sh"], env=env)


def vc_source(mir, metadata):
    names = []
    entries = []
    obligations = []
    entry_window = "[]"
    for body in metadata["bodies"]:
        identity = body["identity"]
        names.append(f"-- Body {identity}" + (" (selected root)" if identity == metadata["rootIdentity"] else ""))
        for index, row in enumerate(body["equations"]):
            block, slot = row["pc"]
            op = row["operation"]
            successors = ", ".join(f"bb{bb}.{stmt}" for bb, stmt in row["targets"])
            detail = f" -> {successors}" if successors else ""
            suffix = f"{identity}_bb{block}_{slot}"
            entries.append(f"  (({identity}, {block}, {slot}), transfer_{suffix} config limits)")
            obligations.extend([
                f"def body_{suffix} (config : Config) (limits : ExecutionMachine.Limits)",
                "    (allowed : State → C → Prop) (depth : Nat) : Prop :=",
                f"  safetyEquation config limits allowed depth (.ofCanonicalIndex {identity}) {index}",
            ])
            names.append(f"-- bb{block}.{slot} {op}{detail}")
            representative_body, representative_block, representative_slot = row["representative"]
            representative = f"{representative_body}_bb{representative_block}_{representative_slot}"
            if representative == suffix:
                names.extend([
                    f"def transfer_{suffix} (config : Config) (limits : ExecutionMachine.Limits) :",
                    "    GeneratedBodyVC.ReducedNode config limits := by",
                    f"  refine ⟨mir_{suffix}, ?_, ?_⟩",
                    "  case refine_2 =>",
                    "    intro choice post failure before",
                    "    symm",
                    f"    miri_reduce_node mir_{suffix}",
                ])
            else:
                names.extend([
                    f"abbrev transfer_{suffix} (config : Config) (limits : ExecutionMachine.Limits) :",
                    "    GeneratedBodyVC.ReducedNode config limits :=",
                    f"  transfer_{representative} config limits",
                ])
        # Emit one reusable suffix at each row. Only the compiler's next
        # statement in the same block is substituted. Calls use the exact
        # callee scope before the shared continuation.
        windows = {}
        for row in reversed(body["equations"]):
            block, slot = row["pc"]
            suffix = f"{identity}_bb{block}_{slot}"
            next_pc = (block, slot + 1)
            tail = (windows.get(next_pc, "[]")
                    if row["statement"] and row["targets"] == [list(next_pc)] else "[]")
            summarize_call = "true" if row["call"] else "false"
            names.extend([
                f"def window_{suffix} (config : Config) (limits : ExecutionMachine.Limits) :",
                "    List (GeneratedBodyVC.WindowRow config limits) :=",
                f"  ⟨⟨.ofCanonicalIndex {identity}, ⟨{block}, {slot}⟩⟩,",
                f"    transfer_{suffix} config limits, {summarize_call}⟩ ::",
                f"    {tail}",
            ])
            windows[block, slot] = f"window_{suffix} config limits"
        if identity == metadata["rootIdentity"]:
            entry_window = windows.get((0, 0), "[]")
        names.append("")
    nodes = "\n".join(names)
    table = ",\n".join(entries)
    checks = "\n".join(obligations)
    return f"""-- Generated by tools/body-vc safety. Root: {lean_string(metadata['root'])}
import Miri.Frontend.ImportBodyVC

namespace GeneratedBodySafety
open Miri.Frontend Miri.Interpreter Miri.Verification Std.WP
set_option maxHeartbeats 10000000
set_option maxRecDepth 65536
set_option experimental.vcgen true

import_body_vc_mir {lean_string(mir.name)} {metadata["rootIndex"]} as input
def loaded : Except String BodyVCGen.LoadedProgram :=
  BodyVCGen.loadProgram input {metadata["rootIndex"]}

section
variable {{K U C O X Host : Type}} [DecidableEq K]
local notation "State" => MachineHooks.State K U
local notation "Config" => ExecutionMachine.Config K U C O X Host

{nodes}
/-- The specialized transfer equations, keyed by the active body and MIR PC. -/
def transferTable (config : Config) (limits : ExecutionMachine.Limits) :
    GeneratedBodyVC.Table config limits := Std.HashMap.ofList [
{table}]

/-- Expose the compiler-selected entry window in a direct `vcgen` proof. -/
abbrev entryWindow (config : Config) (limits : ExecutionMachine.Limits) :
    List (GeneratedBodyVC.WindowRow config limits) :=
  {entry_window}

def entryPre (config : Config) (limits : ExecutionMachine.Limits)
    (program : BodyVCGen.LoadedProgram) (allowed : State → C → Prop)
    (post : WholeBodyWP.Exit → State → Prop) (failure : StepError → State → Prop)
    (before : State) : Prop :=
  WholeBodyWP.entryMatchesLoaded program.root before ∧
    GeneratedBodyVC.windowPre config limits (BodyCFG.compileProgram program.bodies)
      (transferTable config limits) allowed before.stack.frames.size post failure
      (entryWindow config limits) before

theorem entryPre_eq (config : Config) (limits : ExecutionMachine.Limits)
    (program : BodyVCGen.LoadedProgram) (allowed : State → C → Prop)
    (post : WholeBodyWP.Exit → State → Prop) (failure : StepError → State → Prop) :
    entryPre config limits program allowed post failure =
      (BodyVCGen.generateProgram config limits program allowed post failure).pre := by
  funext before
  apply propext
  rw [entryPre, ← GeneratedBodyVC.controlPre_iff_window]
  exact GeneratedBodyVC.pre_iff _ _ _ _ _ _ _ _

/-- The imported whole-body operation with its compiler-selected entry window. -/
def run (config : Config) (limits : ExecutionMachine.Limits) (program : BodyVCGen.LoadedProgram)
    (allowed : State → C → Prop) : BodyVCGen.RunProgram config limits program allowed :=
  GeneratedBodyVC.run config limits program (transferTable config limits) allowed

@[spec] theorem spec_run (config : Config) (limits : ExecutionMachine.Limits)
    (program : BodyVCGen.LoadedProgram) (allowed : State → C → Prop)
    (post : WholeBodyWP.Exit → State → Prop) (failure : StepError → State → Prop) :
    Triple (run config limits program allowed) (entryPre config limits program allowed post failure)
      post failure :=
  GeneratedBodyVC.spec_run_window config limits program (transferTable config limits)
    allowed post failure (entryWindow config limits)

/-- The exact pointwise safety VC at the supplied prepared state. -/
def requiredAt (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (before : State) : Prop :=
  match loaded with
  | .error _ => False
  | .ok program =>
    entryPre config limits program allowed (fun _ _ => True) BodyVCGen.noUB before

/-- Replace the reduced VC with the canonical one when applying existing proofs. -/
theorem requiredAt_eq (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (before : State) :
    requiredAt config limits allowed before =
      (match loaded with
      | .error _ => False
      | .ok program => (BodyVCGen.generateProgram config limits program allowed
          (fun _ _ => True) BodyVCGen.noUB).pre before) := by
  cases selected : loaded <;> simp only [requiredAt, selected, entryPre_eq]

/-- The same VC with every typed choice admitted. -/
abbrev requiredForEveryChoiceAt (config : Config) (limits : ExecutionMachine.Limits)
    (before : State) : Prop :=
  requiredAt config limits (fun _ _ => True) before

/-- The safety VC before production root-call preparation. -/
def requiredFromRoot (config : Config) (limits : ExecutionMachine.Limits)
    (launch : C) (arguments : Array (RvalueImmTy Miri.Memory.Provenance))
    (destination : Option (MPlaceTy Miri.Memory.Provenance)) (span : Miri.MIR.SpanRef)
    (allowed : State → C → Prop) (before : State) : Prop :=
  match loaded with
  | .error _ => False
  | .ok program => wp (BodyVCGen.prepareRoot config limits program launch arguments destination span)
      (fun _ => entryPre config limits program allowed (fun _ _ => True) BodyVCGen.noUB)
      BodyVCGen.noUB before

/-- The reduced root VC is exact through the same production preparation. -/
theorem requiredFromRoot_eq (config : Config) (limits : ExecutionMachine.Limits)
    (launch : C) (arguments : Array (RvalueImmTy Miri.Memory.Provenance))
    (destination : Option (MPlaceTy Miri.Memory.Provenance)) (span : Miri.MIR.SpanRef)
    (allowed : State → C → Prop) (before : State) :
    requiredFromRoot config limits launch arguments destination span allowed before =
      (match loaded with
      | .error _ => False
      | .ok program => BodyVCGen.preparedProgramPre config limits program launch arguments destination
          span allowed (fun _ _ => True) BodyVCGen.noUB before) := by
  cases selected : loaded <;> simp only [requiredFromRoot, selected, BodyVCGen.preparedProgramPre,
    entryPre_eq]

/-- The saved VC holds exactly when the initialized state is at the imported
entry and every permitted finite error in the call scope is non-UB. -/
theorem safetySpec (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (entry : State) (program : BodyVCGen.LoadedProgram)
    (selected : loaded = .ok program) :
    requiredAt config limits allowed entry ↔
      WholeBodyWP.entryMatchesLoaded program.root entry ∧
      ∀ failed error, WholeBodyWP.Finishes (ExecutionMachine.step config limits)
        (fun state => state.stack.frames.size) allowed entry.stack.frames.size
        entry failed (.error error) → RunLoop.reportsUB error = false := by
  simp only [requiredAt_eq, selected, BodyVCGen.generatedProgramPre_eq, WholeBodyWP.catalogBodyPre_iff]
  constructor
  · rintro ⟨entered, checked⟩
    exact ⟨entered, fun failed error run => checked failed (.error error) run⟩
  · rintro ⟨entered, safe⟩
    refine ⟨entered, ?_⟩
    intro after result run
    cases result with
    | ok _ => trivial
    | error error => exact safe after error run

/-- Supply either the safety postcondition or an explicit typed pair of posts
and obtain the equation table used by the actual whole-program generator. -/
def verification (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (post : WholeBodyWP.Exit → State → Prop)
    (failure : StepError → State → Prop) : Except String (BodyVCGen.ProgramConditions State) :=
  loaded.map fun program =>
    {{ GeneratedBodyVC.generateProgram config limits program (transferTable config limits)
        allowed post failure with
      pre := entryPre config limits program allowed post failure }}

/-- Transport verification for arbitrary postconditions to the canonical table. -/
theorem verification_eq (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (post : WholeBodyWP.Exit → State → Prop)
    (failure : StepError → State → Prop) :
    verification config limits allowed post failure =
      loaded.map (fun program => BodyVCGen.generateProgram config limits program allowed post failure) := by
  simp only [verification, GeneratedBodyVC.generateProgram_eq, entryPre_eq] <;> rfl

/-- Individual compiler-bound safety obligations share the whole-body
continuation at every successor, including loop and call successors. -/
def safetyEquation (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (depth : Nat) (identity : BodyIdentity) (index : Nat) : Prop :=
  match loaded with
  | .error _ => False
  | .ok program =>
    let table := transferTable config limits
    let plan := GeneratedBodyVC.generateProgram config limits program table allowed (fun _ _ => True)
      BodyVCGen.noUB
    let again := GeneratedBodyVC.controlPre config limits plan.graph table allowed depth
      (fun _ _ => True) BodyVCGen.noUB
    ((plan.equations (fun _ => again) again identity).bind (·[index]?)).getD False

/-- Transport a named safety obligation to the canonical equation. -/
theorem safetyEquation_eq (config : Config) (limits : ExecutionMachine.Limits)
    (allowed : State → C → Prop) (depth : Nat) (identity : BodyIdentity) (index : Nat) :
    safetyEquation config limits allowed depth identity index =
      (match loaded with
      | .error _ => False
      | .ok program =>
        let plan := BodyVCGen.generateProgram config limits program allowed (fun _ _ => True) BodyVCGen.noUB
        let again := WholeBodyWP.catalogControlPre config limits plan.graph allowed depth
          (fun _ _ => True) BodyVCGen.noUB
        ((plan.equations (fun _ => again) again identity).bind (·[index]?)).getD False) := by
  cases selected : loaded <;> simp only [safetyEquation, selected, GeneratedBodyVC.generateProgram_eq,
    GeneratedBodyVC.controlPre_eq]

{checks}
end

#print axioms safetySpec
end GeneratedBodySafety
"""


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("goal", choices=["safety"])
    parser.add_argument("input", type=Path)
    parser.add_argument("--root", help="Rust def-path to select when the input has multiple functions")
    parser.add_argument("--panic", choices=["abort", "unwind"], default="abort",
                        help="panic strategy for fresh Rust export (default: abort)")
    parser.add_argument("--output", type=Path, default=Path("scratch/BodySafety.lean"))
    parser.add_argument("--no-build", action="store_true", help="reuse existing Lean build artifacts")
    parser.add_argument("--no-check", action="store_true", help="skip the separate generated-file Lean check")
    args = parser.parse_args()
    source, output = args.input.resolve(), args.output.resolve()
    if output.suffix != ".lean" or source.suffix not in {".rs", ".json"}:
        parser.error("the input must be .rs or .json and the output must be .lean")
    if not source.is_file():
        parser.error(f"input does not exist: {source}")

    env = os.environ.copy()
    local_elan = REPO / ".elan"
    if (local_elan / "bin" / "lake").exists():
        env.setdefault("ELAN_HOME", str(local_elan))
        env["PATH"] = str(local_elan / "bin") + os.pathsep + env["PATH"]
    if not args.no_build:
        run(["flock", "--no-fork", "/tmp/lean-miri-lake-build.lock", "lake", "build",
             "Miri.Frontend.ImportBodyVC"], env=env)
    env.setdefault("LEAN_PATH", str(REPO / ".lake" / "build" / "lib" / "lean"))

    output.parent.mkdir(parents=True, exist_ok=True)
    mir = output.with_suffix(".mir.json")
    with tempfile.TemporaryDirectory(dir=output.parent) as directory:
        temporary_mir = Path(directory) / "input.json"
        root = args.root
        if source.suffix == ".rs":
            root = rust_root(source, root)
            exporter_environment(env)
            rust_args = [str(source), "--crate-name", re.sub(r"\W", "_", source.stem),
                         f"-Cpanic={args.panic}"]
            if root != "main":
                rust_args.append("--crate-type=lib")
            start = time.perf_counter()
            run(["bash", "tools/export-mir.sh", "--output", str(temporary_mir), "--root", root,
                 "--", *rust_args], env=env)
            print(f"Rust MIR export: {time.perf_counter() - start:.3f} s", flush=True)
        else:
            shutil.copyfile(source, temporary_mir)
        start = time.perf_counter()
        result = run(["lean", "-j1", "--run", "tools/GenerateBodyVC.lean",
                      str(temporary_mir), *([root] if root else [])], env=env, capture=True)
        metadata = json.loads(result.stdout)
        temporary_mir.replace(mir)
        output.write_text(vc_source(mir, metadata))
        print(f"VC generation and artifact writing: {time.perf_counter() - start:.3f} s", flush=True)

    if not args.no_check:
        start = time.perf_counter()
        run(["lean", "-j1", str(output)], env=env)
        print(f"Generated VC Lean check: {time.perf_counter() - start:.3f} s", flush=True)
    print(f"Saved {output} and {mir}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, subprocess.CalledProcessError) as error:
        details = f"\n{error.stdout.rstrip()}" if isinstance(error, subprocess.CalledProcessError) and error.stdout else ""
        raise SystemExit(f"{error}{details}") from error
