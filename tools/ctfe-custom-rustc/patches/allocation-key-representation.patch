 impl InitMask {
+    /// Read the exact Eq-relevant mask representation without changing it.
+    /// Some(state) denotes Lazy; None denotes Materialized with every block,
+    /// including unused trailing bits and blocks. Callers must not normalize.
+    pub fn lean_miri_complete_init_mask_snapshot(&self) -> (Size, Option<bool>, Vec<u64>) {
+        match &self.blocks {
+            InitMaskBlocks::Lazy { state } => (self.len, Some(*state), Vec::new()),
+            InitMaskBlocks::Materialized(value) => (self.len, None, value.blocks.clone()),
+        }
+    }
