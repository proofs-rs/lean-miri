+impl<Prov: Clone> ProvenanceMap<Prov> {
+    /// Read every Eq-relevant provenance field without merging fragments or
+    /// assuming the interned-allocation None invariant. Preserve Some(empty).
+    pub fn lean_miri_complete_provenance_snapshot(
+        &self,
+    ) -> (Vec<(Size, Prov)>, Option<Vec<(Size, u8, Prov, [u8; 8])>>) {
+        let pointers = self.ptrs.iter().map(|(offset, prov)| (*offset, prov.clone())).collect();
+        let fragments = self.bytes.as_ref().map(|bytes| {
+            bytes.iter().map(|(offset, frag)| (*offset, frag.idx, frag.prov.clone(), frag.bytes)).collect()
+        });
