import Miri.Interpreter.TerminatorMachine

/-! Persistent semantic choice inputs at actual source random-call sites.
This is input data, not a MIR/state/execution representation or a PRNG seed.
Every successful request consumes exactly one fresh typed entry. -/
namespace Miri.Interpreter.ExecutionChoices
open Miri.ABI Miri.Memory
inductive IndexSite where
  | atomicStale | floatNaN | floatMagnitude | scheduler | addressPool | addressSlack | globalSalt
  | threadClockReuse
  | mkstemp
  deriving DecidableEq, Repr
inductive BoolSite where
  | weakCasSuccess | preemption | addressReuse | addressCrossThread | addressFreeReuse
  | floatSign | floatEqual | floatFuse | staticKnown | signalingPow | shortFdOperation
  deriving DecidableEq, Repr
inductive IntegerSite where
  | floatUlp
  deriving DecidableEq, Repr
inductive ByteSite where
  | osRandom
  deriving DecidableEq, Repr
inductive Input where
  | index (site : IndexSite) (value : Nat)
  | boolean (site : BoolSite) (value : Bool)
  | integer (site : IntegerSite) (value : Int)
  | bytes (site : ByteSite) (value : Array UInt8)
  deriving Repr

/-- Exact source request and its support, retained for each consumed choice.
A diagnostic trace is one concrete execution, not a claim that other legal
source outcomes have been checked. -/
inductive Request where
  | index (site : IndexSite) (count : Nat)
  | boolean (site : BoolSite)
  | bernoulli (site : BoolSite) (rateBits : UInt64)
  | integer (site : IntegerSite) (lower upper : Int)
  | bytes (site : ByteSite) (length : Nat)
  deriving Repr

structure Event where
  request : Request
  input : Input
  deriving Repr

/-- Strict finite input remains the default. `boundedDiagnostic` opts into
generating a domain-valid choice only when supplied inputs run out. Its bounds
cap generated draws and the length of each generated byte vector. -/
inductive Policy where
  | strict
  | boundedDiagnostic (maxGeneratedChoices maxByteLength : Nat)
  /-- Deterministic seeded diagnostic draws. This is a replay aid for exploring
  one trace, not rand/Miri PRNG equivalence or exhaustive exploration. -/
  | boundedSeededDiagnostic (maxGeneratedChoices maxByteLength : Nat) (seed : UInt64)
  deriving DecidableEq, Repr

structure Tape where
  inputs : Array Input
  cursor : Nat := 0
  policy : Policy := .strict
  generatedChoices : Nat := 0
  /-- State of the opt-in diagnostic generator. Supplied inputs do not advance it. -/
  diagnosticRngState : UInt64 := 0
  events : Array Event := #[]
  deriving Repr
structure Access (S : Type) where
  get : S → Tape
  put : S → Tape → S
abbrev M S A := EStateM StepError S A
private def unknown (message : String) : M S A := throw (.callback s!"choice input unknown: {message}")
/- SplitMix64 supplies deterministic full-width diagnostic words. Reduction into
typed support still uses modulo, so it is only a replayable way to choose a
legal value; it makes no uniformity or source-PRNG claim. -/
private def nextDiagnosticWord (state : UInt64) : UInt64 × UInt64 :=
  let stateBits : BitVec 64 := BitVec.ofNat 64 state.toNat
  let nextBits := stateBits + BitVec.ofNat 64 0x9E3779B97F4A7C15
  let firstMix := (nextBits ^^^ (nextBits >>> 30)) * BitVec.ofNat 64 0xBF58476D1CE4E5B9
  let secondMix := (firstMix ^^^ (firstMix >>> 27)) * BitVec.ofNat 64 0x94D049BB133111EB
  let output := secondMix ^^^ (secondMix >>> 31)
  (UInt64.ofNat output.toNat, UInt64.ofNat nextBits.toNat)

private def seededDiagnosticInput (request : Request) (maxByteLength : Nat)
    (seed : UInt64) (state : UInt64) (firstGenerated : Bool) : M S (Input × UInt64) := do
  let state := if firstGenerated then seed else state
  match request with
  | .index site count =>
    if count == 0 then throw (.resourceExhaustion "diagnostic choice has empty index support")
    let (word, next) := nextDiagnosticWord state
    return (.index site (word.toNat % count), next)
  | .boolean site =>
    let (word, next) := nextDiagnosticWord state
    return (.boolean site (word.toNat % 2 == 1), next)
  | .bernoulli site rateBits =>
    let falseAllowed ← match TerminatorMachine.permitsPreemption rateBits false with
      | .ok allowed => pure allowed
      | .error error => throw error
    let trueAllowed ← match TerminatorMachine.permitsPreemption rateBits true with
      | .ok allowed => pure allowed
      | .error error => throw error
    unless falseAllowed || trueAllowed do
      throw (.resourceExhaustion "diagnostic choice has empty Bernoulli support")
    let (word, next) := nextDiagnosticWord state
    if !falseAllowed then return (.boolean site true, next)
    if !trueAllowed then return (.boolean site false, next)
    let decoded ← match (FloatBits.mk .binary64 (BitVec.ofNat 128 rateBits.toNat)).decode with
      | .ok value => pure value
      | .error error => throw (.invalidProgram s!"diagnostic Bernoulli probability encoding: {reprStr error}")
    let .finite numerator denominator := decoded.value |
      throw (.invalidProgram "diagnostic Bernoulli probability is nonfinite")
    let threshold := numerator * 2^64 / denominator
    return (.boolean site (word.toNat < threshold), next)
  | .integer site lower upper =>
    if lower > upper then throw (.resourceExhaustion "diagnostic choice has empty integer support")
    let (word, next) := nextDiagnosticWord state
    let count := (upper - lower + 1).toNat
    return (.integer site (lower + Int.ofNat (word.toNat % count)), next)
  | .bytes site length =>
    if length > maxByteLength then
      throw (.resourceExhaustion "diagnostic random-byte choice exceeds byte budget")
    let mut current := state
    let mut bytes := #[]
    for _ in [:length] do
      let (word, next) := nextDiagnosticWord current
      bytes := bytes.push (UInt8.ofNat (word.toNat % 256))
      current := next
    return (.bytes site bytes, current)

/-- Preserve the original deterministic zero-value policy for existing callers. -/
private def diagnosticInput (request : Request) (maxByteLength : Nat) : M S Input := do
  match request with
  | .index site count =>
    if count == 0 then throw (.resourceExhaustion "diagnostic choice has empty index support")
    return .index site 0
  | .boolean site => return .boolean site false
  | .bernoulli site rateBits =>
    let falseAllowed ← match TerminatorMachine.permitsPreemption rateBits false with
      | .ok allowed => pure allowed
      | .error error => throw error
    if falseAllowed then return .boolean site false
    let trueAllowed ← match TerminatorMachine.permitsPreemption rateBits true with
      | .ok allowed => pure allowed
      | .error error => throw error
    if trueAllowed then return .boolean site true
    throw (.resourceExhaustion "diagnostic choice has empty Bernoulli support")
  | .integer site lower upper =>
    if lower > upper then throw (.resourceExhaustion "diagnostic choice has empty integer support")
    return .integer site lower
  | .bytes site length =>
    if length > maxByteLength then
      throw (.resourceExhaustion "diagnostic random-byte choice exceeds byte budget")
    return .bytes site (Array.replicate length 0)

/-- Return the exact supplied input or append one generated diagnostic input.
A supplied but malformed input never falls back to policy generation. -/
private def demand (access : Access S) (request : Request) : M S Input := do
  let tape := access.get (← get)
  if tape.cursor > tape.inputs.size then
    match tape.policy with
    | .strict => pure ()
    | .boundedDiagnostic _ _ | .boundedSeededDiagnostic _ _ _ =>
      throw (.invalidProgram "diagnostic choice cursor exceeds supplied input prefix")
  if let some value := tape.inputs[tape.cursor]? then return value
  match tape.policy with
  | .strict => unknown "tape exhausted"
  | .boundedDiagnostic maxChoices maxByteLength => do
    if tape.generatedChoices >= maxChoices then
      throw (.resourceExhaustion "bounded diagnostic choice count exhausted")
    let value ← diagnosticInput request maxByteLength
    modify fun state =>
      let current := access.get state
      access.put state {current with inputs := current.inputs.push value, generatedChoices := current.generatedChoices + 1}
    return value
  | .boundedSeededDiagnostic maxChoices maxByteLength seed => do
    if tape.generatedChoices >= maxChoices then
      throw (.resourceExhaustion "bounded seeded diagnostic choice count exhausted")
    let (value, nextState) ← seededDiagnosticInput request maxByteLength seed
      tape.diagnosticRngState (tape.generatedChoices == 0)
    modify fun state =>
      let current := access.get state
      access.put state {current with inputs := current.inputs.push value, generatedChoices := current.generatedChoices + 1, diagnosticRngState := nextState}
    return value

private def consume (access : Access S) (request : Request) (value : Input) : M S Unit :=
  modify fun state =>
    let tape := access.get state
    access.put state {tape with cursor := tape.cursor+1, events := tape.events.push ⟨request,value⟩}

/-- Count is the exact source candidate support, not the number of all stores
or threads. An empty source candidate domain fails before examining the tape. -/
def index (access : Access S) (site : IndexSite) (count : Nat) : M S Nat := do
  if count == 0 then throw (.invalidProgram "source random selection has empty support")
  let request := Request.index site count
  let input ← demand access request
  let .index actual value := input | unknown s!"expected index at {repr site}"
  unless actual == site do unknown s!"index site mismatch at {repr site}"
  unless value < count do unknown s!"index outside support at {repr site}"
  consume access request input
  pure value

def boolean (access : Access S) (site : BoolSite) : M S Bool := do
  let request := Request.boolean site
  let input ← demand access request
  let .boolean actual value := input | unknown s!"expected Boolean at {repr site}"
  unless actual == site do unknown s!"Boolean site mismatch at {repr site}"
  consume access request input
  pure value

/-- Restrict support to the exact rand 0.10.3 Bernoulli threshold
`floor(p * 2^64)`: true is possible iff that threshold is nonzero, and false
is possible iff it is less than `2^64`. This also handles probabilities too
small to admit any true sample. -/
def bernoulli (access : Access S) (site : BoolSite) (rateBits : UInt64) : M S Bool := do
  -- Validate source probability before touching unknown input.
  let _ ← match TerminatorMachine.permitsPreemption rateBits false with
    | .ok permitted => pure permitted | .error error => throw error
  let request := Request.bernoulli site rateBits
  let input ← demand access request
  let .boolean actual value := input | unknown s!"expected probability outcome at {repr site}"
  unless actual == site do unknown s!"probability site mismatch at {repr site}"
  let allowed ← match TerminatorMachine.permitsPreemption rateBits value with
    | .ok allowed => pure allowed | .error error => throw error
  unless allowed do unknown s!"Boolean outside probability support at {repr site}"
  consume access request input
  pure value

def integer (access : Access S) (site : IntegerSite) (lower upper : Int) : M S Int := do
  if lower > upper then throw (.invalidProgram "source random integer range is empty")
  let request := Request.integer site lower upper
  let input ← demand access request
  let .integer actual value := input | unknown s!"expected integer at {repr site}"
  unless actual == site do unknown s!"integer site mismatch at {repr site}"
  unless lower <= value && value <= upper do unknown s!"integer outside support at {repr site}"
  consume access request input
  pure value

/-- A source fill_bytes/getrandom draw is consumed before the physical write.
The full vector is one choice; no PRNG seed or per-byte reused selector exists. -/
def bytes (access : Access S) (site : ByteSite) (length : Nat) : M S ByteArray := do
  let request := Request.bytes site length
  let input ← demand access request
  let .bytes actual value := input | unknown s!"expected bytes at {repr site}"
  unless actual == site do unknown s!"byte site mismatch at {repr site}"
  unless value.size == length do unknown s!"byte vector length mismatch at {repr site}"
  consume access request input
  pure ⟨value⟩

/-- Compose a tape lens through an owner's existing state; all actual memory,
clock, stack and provenance fields remain in that one state. -/
def through (outerGet : T → S) (outerPut : T → S → T) (inner : Access S) : Access T := {
  get := fun state => inner.get (outerGet state)
  put := fun state tape => outerPut state (inner.put (outerGet state) tape) }

structure User (Payload : Type) where
  payload : Payload
  choices : Tape

def userAccess : Access (User U) := ⟨(·.choices),fun user tape => {user with choices := tape}⟩
end Miri.Interpreter.ExecutionChoices
