+#[cfg(feature = "miri-reference")]
+fn prepared_miri_reference_seed() -> Result<Option<u64>, String> {
+    match env::var("LEAN_MIRI_REFERENCE_SEED") {
+        Ok(value) => value
+            .parse::<u64>()
+            .map(Some)
+            .map_err(|_| "LEAN_MIRI_REFERENCE_SEED must be an unsigned 64-bit integer".into()),
+        Err(env::VarError::NotPresent) => Ok(None),
+        Err(error) => Err(format!("cannot read prepared Miri seed: {error}")),
+    }
+}
+
+#[cfg(feature = "miri-reference")]
+fn prepared_miri_reference_preemption_rate() -> Result<Option<f64>, String> {
+    match env::var("LEAN_MIRI_REFERENCE_PREEMPTION_RATE") {
+        Ok(value) => {
+            let rate = value
+                .parse::<f64>()
+                .map_err(|_| "LEAN_MIRI_REFERENCE_PREEMPTION_RATE must be a finite number in [0,1]".to_owned())?;
+            if !rate.is_finite() || !(0.0..=1.0).contains(&rate) {
+                return Err("LEAN_MIRI_REFERENCE_PREEMPTION_RATE must be a finite number in [0,1]".into());
+            }
+            Ok(Some(rate))
+        }
+        Err(env::VarError::NotPresent) => Ok(None),
+        Err(error) => Err(format!("cannot read prepared Miri preemption rate: {error}")),
+    }
+}
