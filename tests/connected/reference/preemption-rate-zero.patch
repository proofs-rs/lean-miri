+fn prepared_miri_reference_profile() -> Result<(Option<u64>, Option<f64>, Option<String>), String> {
+    let seed = match env::var("LEAN_MIRI_REFERENCE_SEED") {
+        Ok(value) => Some(value.parse::<u64>().map_err(|_| "LEAN_MIRI_REFERENCE_SEED must be an unsigned 64-bit integer".to_owned())?),
+        Err(env::VarError::NotPresent) => None,
+        Err(error) => return Err(format!("cannot read prepared Miri seed: {error}")),
+    };
+    let rate = match env::var("LEAN_MIRI_REFERENCE_PREEMPTION_RATE") {
+        Ok(value) => {
+            let rate = value.parse::<f64>().map_err(|_| "LEAN_MIRI_REFERENCE_PREEMPTION_RATE must be finite and in [0,1]".to_owned())?;
+            if !rate.is_finite() || !(0.0..=1.0).contains(&rate) {
+                return Err("LEAN_MIRI_REFERENCE_PREEMPTION_RATE must be finite and in [0,1]".into());
+            }
+            Some(rate)
+        },
+        Err(env::VarError::NotPresent) => None,
+        Err(error) => return Err(format!("cannot read prepared Miri preemption rate: {error}")),
+    };
+    let argv0 = match env::var("LEAN_MIRI_REFERENCE_ARGV0") {
+        Ok(value) => Some(value),
+        Err(env::VarError::NotPresent) => None,
+        Err(error) => return Err(format!("cannot read prepared Miri argv[0]: {error}")),
+    };
+    Ok((seed, rate, argv0))
+}
