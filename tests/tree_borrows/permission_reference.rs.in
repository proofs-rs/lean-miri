    use super::wildcard::WildcardAccessLevel;

    #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    enum PermissionPriv {
        Cell,
        ReservedFrz { conflicted: bool },
        ReservedIM,
        Unique,
        Frozen,
        Disabled,
    }
    use self::PermissionPriv::*;

    // These blocks are copied byte-for-byte from pinned `perms.rs` after the
    // extractor checks the entire file's Git blob hash.
    // @PINNED_PERMISSION_IMPLS@
    impl PermTransition {
        // @PINNED_TRANSITION_ENDPOINT@
    }

    // Test-only accessors stay in this module so the source's private
    // transition invariant and endpoints can be compared without changing
    // the extracted public API.
    pub(super) fn transition_facts(
        transition: PermTransition,
        starting_point: Permission,
    ) -> Option<(Permission, bool, bool, bool)> {
        let _ = transition.applied(starting_point)?;
        Some((
            transition.endpoint(),
            transition.is_noop(),
            transition.produces_disabled(),
            transition.is_possible(),
        ))
    }
}

