//! Standalone harness around byte-exact permission helpers extracted from the
//! pinned Miri source. See `extract_reference.py` for all source hash checks.

use std::panic::{catch_unwind, AssertUnwindSafe};
use std::collections::HashMap;

extern crate self as rustc_abi;

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct Size { bytes: u64 }

impl Size {
    pub fn from_bytes(bytes: u64) -> Self { Self { bytes } }
    pub fn bytes(self) -> u64 { self.bytes }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
struct BorTag(u64);

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
struct Event;

#[derive(Clone, Debug, PartialEq, Eq)]
struct NodeDebugInfo { history: Vec<Event> }

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
struct AllocRange { start: Size, size: Size }

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
struct Span;

type AllocId = u64;

struct MiriMachine<'tcx> { _marker: std::marker::PhantomData<&'tcx ()> }
impl MiriMachine<'_> {
    fn current_user_relevant_span(&self) -> Span { Span }
}

type VisitWith<'a> = dyn FnMut(Option<AllocId>, Option<BorTag>) + 'a;
trait VisitProvenance {
    fn visit_provenance(&self, visit: &mut VisitWith<'_>);
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
enum AccessCause { Dealloc, FnExit(AccessKind), Test }

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
enum ProvenanceExtra { Concrete(BorTag), Wildcard }

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
enum ProtectorKind { WeakProtector, StrongProtector }

struct DiagnosticInfo {
    alloc_id: AllocId,
    span: Span,
    transition_range: std::ops::Range<u64>,
    access_range: Option<AllocRange>,
    access_cause: AccessCause,
}
impl DiagnosticInfo {
    fn create_event(
        &self,
        _transition: source_permissions::PermTransition,
        _foreign: bool,
    ) -> Event { Event }

    fn fixture() -> Self {
        Self {
            alloc_id: 0,
            span: Span,
            transition_range: 0..1,
            access_range: None,
            access_cause: AccessCause::Test,
        }
    }
}

#[allow(unused_lifetimes)]
type InterpResult<'tcx, T = ()> = Result<T, String>;

fn interp_ok<T>(value: T) -> InterpResult<'static, T> { Ok(value) }

fn no_valid_exposed_references_error(_diagnostics: &DiagnosticInfo) -> String {
    "no-valid-exposed-references".to_owned()
}

struct GlobalState { protected_tags: HashMap<BorTag, ProtectorKind> }
impl GlobalState {
    fn borrow(&self) -> &Self { self }
}

type FxHashSet<T> = std::collections::HashSet<T>;

struct TbError<'a> {
    error_kind: source_location::TransitionError,
    access_info: &'a DiagnosticInfo,
    conflicting_node_info: &'a NodeDebugInfo,
    accessed_node_info: Option<&'a NodeDebugInfo>,
}
impl TbError<'_> {
    fn build(self) -> String { "tree-borrows-transition-error".to_owned() }
}

