pub mod unimap {
    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
    pub struct UniIndex {
        pub idx: usize,
    }

    #[derive(Clone, Debug, Eq)]
    pub struct UniValMap<V> {
        data: Vec<Option<V>>,
    }

    // Extracted byte-for-byte from pinned unimap.rs; this is the equality
    // consulted by the exact DedupRangeMap code during adjacent-range merging.
    // @PINNED_UNIMAP_EQUIVALITY@

    impl<V> UniValMap<V> {
        pub fn from_vec(data: Vec<Option<V>>) -> Self {
            Self { data }
        }

        pub fn get(&self, idx: UniIndex) -> Option<&V> {
            self.data.get(idx.idx).and_then(Option::as_ref)
        }

        pub fn get_mut(&mut self, idx: UniIndex) -> Option<&mut V> {
            self.data.get_mut(idx.idx).and_then(Option::as_mut)
        }

        pub fn iter(&self) -> impl Iterator<Item=(UniIndex, &V)> {
            self.data.iter().enumerate().filter_map(|(idx, value)| {
                value.as_ref().map(|value| (UniIndex { idx }, value))
            })
        }

        pub fn len(&self) -> usize { self.data.len() }

        pub fn insert(&mut self, idx: UniIndex, value: V) {
            if self.data.len() <= idx.idx { self.data.resize_with(idx.idx + 1, || None); }
            self.data[idx.idx] = Some(value);
        }

        pub fn remove(&mut self, idx: UniIndex) -> Option<V> {
            self.data.get_mut(idx.idx).and_then(Option::take)
        }

        pub fn truncate_for_fixture(&mut self, len: usize) { self.data.truncate(len); }

        pub fn entry(&mut self, idx: UniIndex) -> UniEntry<'_, V> {
            if self.data.len() <= idx.idx { self.data.resize_with(idx.idx + 1, || None); }
            UniEntry { inner: &mut self.data[idx.idx] }
        }
    }

    pub struct UniEntry<'a, V> { inner: &'a mut Option<V> }
    impl<V> UniEntry<'_, V> {
        pub fn or_insert(&mut self, default: V) -> &mut V {
            if self.inner.is_none() { *self.inner = Some(default); }
            self.inner.as_mut().unwrap()
        }
    }

    impl<V> Default for UniValMap<V> {
        fn default() -> Self { Self { data: Vec::new() } }
    }
}

