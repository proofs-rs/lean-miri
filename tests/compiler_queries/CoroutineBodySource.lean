import Miri.Input.CoroutineBodyDispatch
import Miri.Input.GenericMaterialCodec

open Lean Miri.Input Miri.Input.CoroutineBodyDispatch
private def must (value : Except String α) : IO α :=
  match value with | .ok value => pure value | .error error => throw (IO.userError error)

def main (args : List String) : IO Unit := do
  let [path] := args | throw (IO.userError "usage: CoroutineBodySource ORACLE")
  let rows ← must ((← must (Json.parse (← IO.FS.readFile path))).getArr?)
  let mut generated := 0
  for row in rows do
    let owner ← must ((← must (row.getObjVal? "owner")).getNat?)
    let selected ← must ((← must (row.getObjVal? "selected_owner")).getNat?)
    let identity ← must (kindOfTerm (← must (GenericMaterialCodec.readTerm 64 (← must (row.getObjVal? "identity_kind_tree")))))
    let requested ← must (kindOfTerm (← must (GenericMaterialCodec.readTerm 64 (← must (row.getObjVal? "requested_kind_tree")))))
    let movedJson ← must (row.getObjVal? "by_move_owner")
    let moved ← if movedJson == Json.null then pure none else do
      pure (some ⟨0,← must movedJson.getNat?⟩)
    let actual ← must (select ⟨⟨0,owner⟩,identity,moved,.ordinary⟩ requested)
    unless actual == ⟨0,selected⟩ do throw (IO.userError "raw source physical body owner differs")
    unless (← must (row.getObjVal? "source")) == (← must (row.getObjVal? "oracle")) do
      throw (IO.userError "selected raw body relations differ from compiler query")
    if owner != selected then generated := generated + 1
  unless generated > 0 do throw (IO.userError "generated by-move body coverage absent")
  IO.println s!"PASS {rows.size} actual body source choices, {generated} generated by-move bodies"
