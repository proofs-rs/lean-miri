use std::num::NonZero;
use std::sync::atomic::{AtomicU64, Ordering};

#[derive(Clone, Copy, Debug)]
struct AllocId(NonZero<u64>);
struct AllocMap { next_id: AtomicU64 }
impl AllocMap {
    /* EXTRACTED_RESERVE */
}

fn main() {
    let map = AllocMap { next_id: AtomicU64::new(1) };
    let first = map.reserve();
    let second = map.reserve();
    println!("ids first={} second={}", first.0.get(), second.0.get());

    let max = AllocMap { next_id: AtomicU64::new(u64::MAX) };
    let max_id = max.reserve();
    println!("max id={} next={}", max_id.0.get(), max.next_id.load(Ordering::Relaxed));

    let zero = AllocMap { next_id: AtomicU64::new(0) };
    let panicked = std::panic::catch_unwind(|| zero.reserve()).is_err();
    println!("zero panic={} next={}", panicked,
        zero.next_id.load(Ordering::Relaxed));
}
